<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login System</title>

  <!-- Bootstrap CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins&display=swap" rel="stylesheet">

  <!-- Custom CSS -->
  <link rel="stylesheet" href="styles.css">
</head>

<body class="d-flex justify-content-center align-items-center vh-100">

  <div class="card shadow">
    <h3 class="text-center">Login</h3>
    <input type="text" class="form-control mt-3" placeholder="Username">
    <input type="password" class="form-control mt-3" placeholder="Password">
    <button class="btn btn-primary mt-3 w-100">Login</button>
    <a href="forgot.html" class="d-block text-center mt-3">Forgot Password?</a>
    <a href="register.html" class="d-block text-center">Create New Account</a>
  </div>

  <!-- Bootstrap JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>